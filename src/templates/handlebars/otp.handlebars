<!-- Hero Banner -->
<tr>
  <td style="padding: 16px 24px 0 24px; background-color: #ffffff;" class="p-mobile">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background: linear-gradient(135deg, #1b3c53 0%, #203a43 100%); border-radius: 16px; overflow: hidden;">
      <tr>
        <td width="70%" valign="middle" style="padding: 32px 20px 32px 28px;" class="p-mobile">
          <div style="display: inline-block; background-color: rgba(245, 166, 35, 0.2); border: 1px solid rgba(245, 166, 35, 0.4); color: #f5a623; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 10px;">
            Two-Factor Authentication
          </div>
          <h1 class="hero-title" style="margin: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 24px; font-weight: 900; color: #ffffff; line-height: 1.2; text-transform: uppercase;">
            Verification<br>
            <span style="color: #f5a623;">Passcode</span>
          </h1>
          <p style="margin: 8px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #cbd5e1;">
            {{#if purpose}}Purpose: {{purpose}}{{else}}Security Verification{{/if}}
          </p>
        </td>
        <td width="30%" valign="middle" align="center" style="padding: 20px 20px 20px 0;">
          <div style="width: 64px; height: 64px; background-color: rgba(245, 166, 35, 0.15); border: 2px solid #f5a623; border-radius: 50%; text-align: center; line-height: 64px; font-size: 28px;">
            🔒
          </div>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body Content -->
<tr>
  <td style="padding: 32px 36px 16px 36px; background-color: #ffffff;" class="p-mobile">
    <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #334155; line-height: 1.6;">
      Dear <strong>{{name}}</strong>,
    </p>
    <p style="margin: 0 0 24px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #475569; line-height: 1.6;">
      Use the 6-digit one-time passcode below to complete your authorization request. This code will expire in <strong>{{#if expiresInMinutes}}{{expiresInMinutes}}{{else}}10{{/if}} minutes</strong>.
    </p>

    <!-- OTP Code Display Card -->
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; margin-bottom: 24px;">
      <tr>
        <td align="center" style="padding: 28px 16px;">
          <table border="0" cellpadding="0" cellspacing="0">
            <tr>
              {{#each otpDigits}}
              <td align="center" style="width: 44px; height: 56px; background-color: #ffffff; border: 2px solid #102a43; border-radius: 8px; font-family: Consolas, 'Courier New', monospace; font-size: 30px; font-weight: 900; color: #102a43; line-height: 56px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);">{{this}}</td>
              <td width="8">&nbsp;</td>
              {{/each}}
            </tr>
          </table>
          <div style="margin-top: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em;">
            Single-use Security Code
          </div>
        </td>
      </tr>
    </table>

    <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #991b1b; margin-bottom: 2px;">
        ⚠️ Never share your security code
      </div>
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #b91c1c; line-height: 1.4;">
        Farmanullah Ansari Company employees will never ask for your verification code via phone, email, or messaging apps.
      </div>
    </div>
  </td>
</tr>
