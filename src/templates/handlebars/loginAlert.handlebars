<!-- Hero Banner -->
<tr>
  <td style="padding: 16px 24px 0 24px; background-color: #ffffff;" class="p-mobile">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background: linear-gradient(135deg, #1b3c53 0%, #1e293b 100%); border-radius: 16px; overflow: hidden;">
      <tr>
        <td width="65%" valign="middle" style="padding: 32px 20px 32px 28px;" class="p-mobile">
          <div style="display: inline-block; background-color: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.35); color: #38bdf8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 10px;">
            Security Notification
          </div>
          <h1 class="hero-title" style="margin: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 24px; font-weight: 900; color: #ffffff; line-height: 1.2; text-transform: uppercase;">
            New Login<br>
            <span style="color: #f5a623;">Detected</span>
          </h1>
          <p style="margin: 8px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #cbd5e1;">
            We noticed a recent sign-in to your account.
          </p>
        </td>
        <td width="35%" valign="middle" align="center" style="padding: 20px 20px 20px 0;">
          <div style="width: 64px; height: 64px; background-color: rgba(245, 166, 35, 0.15); border: 2px solid #f5a623; border-radius: 50%; text-align: center; line-height: 64px; font-size: 30px;">
            🛡️
          </div>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Details Section -->
<tr>
  <td style="padding: 28px 36px 12px 36px; background-color: #ffffff;" class="p-mobile">
    <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #334155; line-height: 1.6;">
      Hello <strong>{{name}}</strong>,
    </p>
    <p style="margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #475569; line-height: 1.6;">
      A new successful sign-in occurred on your <strong>Farmanullah Ansari Company</strong> account. Below are the details of the session:
    </p>

    <!-- Session Details Table -->
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; margin-bottom: 24px;">
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td width="35%" style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Device / Client
        </td>
        <td width="65%" style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{#if device}}{{device}}{{else}}Web Browser{{/if}}
        </td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0; background-color: #ffffff;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          IP Address
        </td>
        <td style="padding: 12px 16px; font-family: Consolas, monospace; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{#if ipAddress}}{{ipAddress}}{{else}}127.0.0.1{{/if}}
        </td>
      </tr>
      {{#if location}}
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Approx. Location
        </td>
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{location}}
        </td>
      </tr>
      {{/if}}
      <tr style="background-color: #ffffff;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Time
        </td>
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{#if timestamp}}{{timestamp}}{{else}}Just now{{/if}}
        </td>
      </tr>
    </table>

    <div style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #92400e; margin-bottom: 4px;">
        Was this you?
      </div>
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #b45309; line-height: 1.5;">
        If you recognize this login, you can safely ignore this email. If this wasn't you, someone may have access to your account. Please secure your account immediately.
      </div>
    </div>
  </td>
</tr>

<!-- Action Button: Secure Account -->
<tr>
  <td align="center" style="padding: 0 36px 36px 36px; background-color: #ffffff;" class="p-mobile">
    <table border="0" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="border-radius: 30px; background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); box-shadow: 0 4px 14px rgba(225, 29, 72, 0.35);">
          <a href="{{#if securityUrl}}{{securityUrl}}{{else}}#{{/if}}" target="_blank" style="display: inline-block; padding: 14px 36px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 800; color: #ffffff; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em;">
            Not You? Secure Your Account &rarr;
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>
