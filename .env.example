# ==============================================================================
# SMTP & Nodemailer Lab - Environment Configuration Template
# ==============================================================================

# Server configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Active SMTP Credentials (Used by config/mailer.js)
# ------------------------------------------------------------------------------
# Leave blank to trigger automatic ephemeral Ethereal testing account creation:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nodemailer Lab" <no-reply@example.com>

# ------------------------------------------------------------------------------
# Microsoft SQL Server (Sequelize + msnodesqlv8 / Windows Auth)
# ------------------------------------------------------------------------------
SERVER=localhost
DATABASE=somenewdatabase

# ------------------------------------------------------------------------------
# ImageKit Media Storage Configuration
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ------------------------------------------------------------------------------
# Configuration Examples for Popular SMTP Providers
# ------------------------------------------------------------------------------

# --- 1. GMAIL (Requires 2-Factor Authentication & Google App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourusername@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="My Gmail App" <yourusername@gmail.com>

# --- 2. MAILTRAP (Sandbox / Development Email Catcher) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# MAIL_FROM="Mailtrap Sandbox" <sandbox@example.com>

# --- 3. BREVO (Production Transactional Provider) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_account_login_email
# SMTP_PASS=your_master_smtp_key
# MAIL_FROM="My SaaS App" <verified-sender@yourdomain.com>
