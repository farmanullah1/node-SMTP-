<!-- Hero Banner -->
<tr>
  <td style="padding: 16px 24px 0 24px; background-color: #ffffff;" class="p-mobile">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background: #1b3c53; background: linear-gradient(135deg, #1b3c53 0%, #174251 100%); border-radius: 16px; overflow: hidden;">
      <tr>
        <td width="65%" valign="middle" style="padding: 32px 20px 32px 28px;" class="p-mobile">
          <div style="display: inline-block; background-color: rgba(245, 166, 35, 0.2); border: 1px solid rgba(245, 166, 35, 0.4); color: #f5a623; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 10px;">
            Email Verification
          </div>
          <h1 class="hero-title" style="margin: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 24px; font-weight: 900; color: #ffffff; line-height: 1.2; text-transform: uppercase;">
            Verify Your<br>
            <span style="color: #f5a623;">Email Address</span>
          </h1>
          <p style="margin: 8px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #cbd5e1;">
            Confirm your identity to activate all enterprise services.
          </p>
        </td>
        <td width="35%" valign="middle" align="center" style="padding: 20px 20px 20px 0;">
          <div style="width: 64px; height: 64px; background-color: rgba(245, 166, 35, 0.15); border: 2px solid #f5a623; border-radius: 50%; text-align: center; line-height: 64px; font-size: 28px;" aria-hidden="true">
            ✉️
          </div>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body Content -->
<tr>
  <td style="padding: 32px 36px 20px 36px; background-color: #ffffff;" class="p-mobile">
    <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #334155; line-height: 1.6;">
      Hello <strong>{{name}}</strong>,
    </p>
    <p style="margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #475569; line-height: 1.6;">
      Thank you for registering with <strong>Farmanullah Ansari Company</strong>. To ensure the security of your account and activate your full access, please verify your email address:
    </p>

    <!-- Primary Action Button (Bulletproof with Outlook VML Support) -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 26px 0;">
      <tr>
        <td align="center">
          <!--[if mso]>
          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{verificationUrl}}" style="height:48px;v-text-anchor:middle;width:260px;" arcsize="50%" stroke="f" fillcolor="#f5a623">
            <w:anchorlock/>
            <center style="color:#102a43;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:bold;letter-spacing:0.08em;">VERIFY EMAIL ADDRESS &rarr;</center>
          </v:roundrect>
          <![endif]-->
          <!--[if !mso]><!-->
          <table role="presentation" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td align="center" style="border-radius: 30px; background: #f5a623; background: linear-gradient(135deg, #f5a623 0%, #e08e0b 100%); box-shadow: 0 4px 14px rgba(245, 166, 35, 0.4); mso-padding-alt: 0;">
                <a href="{{verificationUrl}}" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 14px 40px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; font-weight: 800; color: #102a43; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; border-radius: 30px;">
                  Verify Email Address &rarr;
                </a>
              </td>
            </tr>
          </table>
          <!--<![endif]-->
        </td>
      </tr>
    </table>

    <p style="margin: 0 0 12px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b; line-height: 1.5;">
      If the button above does not work, copy and paste the following direct URL into your browser:
    </p>
    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 12px; word-break: break-all; font-family: Consolas, monospace; font-size: 11px; color: #334155; margin-bottom: 20px;">
      {{verificationUrl}}
    </div>

    {{#if token}}
    <div style="margin-bottom: 20px;">
      <span style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b;">Or enter this verification token manually:</span>
      <div style="font-family: Consolas, monospace; font-size: 13px; font-weight: 700; color: #102a43; margin-top: 4px; background-color: #f1f5f9; padding: 6px 10px; border-radius: 4px; display: inline-block;">{{token}}</div>
    </div>
    {{/if}}

    <div style="background-color: #f1f5f9; border-radius: 6px; padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b; line-height: 1.5;">
      ⏱️ This link is valid for <strong>{{#if expiresInHours}}{{expiresInHours}}{{else}}24{{/if}} hours</strong>. If you did not create an account with us, you can safely ignore this email.
    </div>
  </td>
</tr>
