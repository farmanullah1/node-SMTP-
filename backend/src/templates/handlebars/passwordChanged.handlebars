<!-- Hero Banner -->
<tr>
  <td style="padding: 16px 24px 0 24px; background-color: #ffffff;" class="p-mobile">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background: #1b3c53; background: linear-gradient(135deg, #1b3c53 0%, #1e293b 100%); border-radius: 16px; overflow: hidden;">
      <tr>
        <td width="65%" valign="middle" style="padding: 32px 20px 32px 28px;" class="p-mobile">
          <div style="display: inline-block; background-color: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 10px;">
            Security Notice
          </div>
          <h1 class="hero-title" style="margin: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 24px; font-weight: 900; color: #ffffff; line-height: 1.2; text-transform: uppercase;">
            Password<br>
            <span style="color: #10b981;">Updated</span>
          </h1>
          <p style="margin: 8px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #cbd5e1;">
            Your account password was successfully updated.
          </p>
        </td>
        <td width="35%" valign="middle" align="center" style="padding: 20px 20px 20px 0;">
          <div style="width: 64px; height: 64px; background-color: rgba(16, 185, 129, 0.15); border: 2px solid #10b981; border-radius: 50%; text-align: center; line-height: 64px; font-size: 28px;" aria-hidden="true">
            ✅
          </div>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body Content -->
<tr>
  <td style="padding: 32px 36px 20px 36px; background-color: #ffffff;" class="p-mobile">
    <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #334155; line-height: 1.6;">
      Hello <strong>{{name}}</strong>,
    </p>
    <p style="margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #475569; line-height: 1.6;">
      The password for your <strong>Farmanullah Ansari Company</strong> account was changed on <strong>{{#if timestamp}}{{timestamp}}{{else}}just now{{/if}}</strong>.
    </p>

    <!-- Audit Details Card -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; margin-bottom: 24px;">
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td width="35%" style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Event
        </td>
        <td width="65%" style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 600; color: #0f172a;">
          Password Change Confirmed
        </td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0; background-color: #ffffff;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          IP Address
        </td>
        <td style="padding: 12px 16px; font-family: Consolas, monospace; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{#if ipAddress}}{{ipAddress}}{{else}}127.0.0.1{{/if}}
        </td>
      </tr>
      {{#if device}}
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Device
        </td>
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 600; color: #0f172a;">
          {{device}}
        </td>
      </tr>
      {{/if}}
      <tr style="background-color: #ffffff;">
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          Status
        </td>
        <td style="padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #15803d;">
          Active &amp; Secured
        </td>
      </tr>
    </table>

    <div style="background-color: #fff1f2; border: 1px solid #fecdd3; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #9f1239; margin-bottom: 4px;">
        Didn't make this change?
      </div>
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #be123c; line-height: 1.5;">
        If you did not change your password, someone may have unauthorized access to your account. Lock your account and reset your credentials immediately using the button below.
      </div>
    </div>

    <!-- Primary Action Button: Lock & Secure Account -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 20px 0 10px 0;">
      <tr>
        <td align="center">
          <!--[if mso]>
          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{#if securityUrl}}{{securityUrl}}{{else}}#{{/if}}" style="height:48px;v-text-anchor:middle;width:280px;" arcsize="50%" stroke="f" fillcolor="#e11d48">
            <w:anchorlock/>
            <center style="color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;font-weight:bold;letter-spacing:0.08em;">SECURE MY ACCOUNT NOW &rarr;</center>
          </v:roundrect>
          <![endif]-->
          <!--[if !mso]><!-->
          <table role="presentation" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td align="center" style="border-radius: 30px; background: #e11d48; background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); box-shadow: 0 4px 14px rgba(225, 29, 72, 0.35); mso-padding-alt: 0;">
                <a href="{{#if securityUrl}}{{securityUrl}}{{else}}#{{/if}}" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 14px 36px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 800; color: #ffffff; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; border-radius: 30px;">
                  Secure My Account Now &rarr;
                </a>
              </td>
            </tr>
          </table>
          <!--<![endif]-->
        </td>
      </tr>
    </table>
  </td>
</tr>
