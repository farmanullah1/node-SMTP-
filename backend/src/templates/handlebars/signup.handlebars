<!-- Hero Banner -->
<tr>
  <td style="padding: 16px 24px 0 24px; background-color: #ffffff;" class="p-mobile">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background: #1b3c53; background: linear-gradient(135deg, #1b3c53 0%, #224c68 100%); border-radius: 16px; overflow: hidden; position: relative;">
      <tr>
        <td width="58%" valign="middle" style="padding: 36px 20px 36px 28px;" class="p-mobile">
          <div style="display: inline-block; background-color: rgba(245, 166, 35, 0.2); border: 1px solid rgba(245, 166, 35, 0.4); color: #f5a623; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 12px;">
            Account Registration
          </div>
          <h1 class="hero-title" style="margin: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 26px; font-weight: 900; color: #ffffff; line-height: 1.15; text-transform: uppercase; letter-spacing: -0.5px;">
            Welcome<br>
            <span style="color: #f5a623;">Aboard!</span>
          </h1>
          <p style="margin: 10px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #cbd5e1; line-height: 1.4;">
            Your account is ready. Let's get you set up.
          </p>
        </td>
        <td width="42%" valign="bottom" align="right" style="padding: 0; line-height: 0;">
          <!--[if mso]>
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="right">
            <tr>
              <td align="center" valign="middle" style="padding: 24px 20px; font-size: 42px;">
                🚀
              </td>
            </tr>
          </table>
          <![endif]-->
          <!--[if !mso]><!-->
          <!-- Modern Team / Office SVG -->
          <svg width="200" height="150" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block; max-width: 100%; height: auto;" role="img" aria-label="Welcome Illustration">
            <circle cx="180" cy="130" r="80" fill="#f5a623" />
            <circle cx="100" cy="65" r="18" fill="#38bdf8" />
            <path d="M70 120 C70 95, 130 95, 130 120 Z" fill="#ffffff" />
            <circle cx="150" cy="80" r="14" fill="#fbbf24" />
            <path d="M125 125 C125 105, 175 105, 175 125 Z" fill="#0f172a" />
            <rect x="40" y="100" width="36" height="24" rx="4" fill="#64748b" opacity="0.7" />
          </svg>
          <!--<![endif]-->
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Greeting & Body Copy -->
<tr>
  <td style="padding: 32px 36px 20px 36px; background-color: #ffffff;" class="p-mobile">
    <h2 style="margin: 0 0 12px 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 20px; font-weight: 800; color: #102a43; line-height: 1.3;">
      Welcome to the Family, <span style="color: #f5a623;">{{name}}</span>!
    </h2>
    <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #486581; line-height: 1.6;">
      We're excited to have you join <strong>Farmanullah Ansari Company</strong>! We build state-of-the-art enterprise solutions with a commitment to excellence, innovation, and reliability.
    </p>
    {{#if verificationUrl}}
    <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 14px 18px; margin: 18px 0;">
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #166534; margin-bottom: 4px;">
        Action Required: Confirm Your Email
      </div>
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #15803d; line-height: 1.5;">
        Please click the button below to verify your email address and activate all features.
      </div>
    </div>
    {{/if}}
  </td>
</tr>

<!-- Getting Started Steps -->
<tr>
  <td style="padding: 0 36px 24px 36px; background-color: #ffffff;" class="p-mobile">
    <div style="font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 12px; font-weight: 800; color: #102a43; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px;">
      Getting Started Checklist
    </div>

    <!-- Step 1 -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 12px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <tr>
        <td width="48" align="center" valign="middle" style="padding: 12px;">
          <div style="width: 28px; height: 28px; background-color: #102a43; color: #ffffff; border-radius: 50%; font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; line-height: 28px; text-align: center;">
            1
          </div>
        </td>
        <td valign="middle" style="padding: 12px 14px 12px 0;">
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #102a43;">
            Setup Your Profile
          </div>
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b; line-height: 1.4;">
            Log in to customize your personal preferences and notification rules.
          </div>
        </td>
      </tr>
    </table>

    <!-- Step 2 -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 12px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <tr>
        <td width="48" align="center" valign="middle" style="padding: 12px;">
          <div style="width: 28px; height: 28px; background-color: #102a43; color: #ffffff; border-radius: 50%; font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; line-height: 28px; text-align: center;">
            2
          </div>
        </td>
        <td valign="middle" style="padding: 12px 14px 12px 0;">
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #102a43;">
            Explore Core Services
          </div>
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b; line-height: 1.4;">
            Review our API endpoints, transactional email delivery, and media CDN.
          </div>
        </td>
      </tr>
    </table>

    <!-- Step 3 -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <tr>
        <td width="48" align="center" valign="middle" style="padding: 12px;">
          <div style="width: 28px; height: 28px; background-color: #102a43; color: #ffffff; border-radius: 50%; font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 800; line-height: 28px; text-align: center;">
            3
          </div>
        </td>
        <td valign="middle" style="padding: 12px 14px 12px 0;">
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #102a43;">
            Dedicated Help &amp; Documentation
          </div>
          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #64748b; line-height: 1.4;">
            Access our 24/7 support portal and developer learning guides.
          </div>
        </td>
      </tr>
    </table>
  </td>
</tr>

